// Microsoft Visual C++ generated resource script.
//
#include "resource.h"
#include "orca-version.h"
#include <winver.h>
IDI_ICON1               ICON                    "..\\..\\..\\Distribution\\Windows\\Dolphin.ico"
"dolphin"               ICON                    "..\\..\\..\\Distribution\\Windows\\Dolphin.ico"

// What Windows, Task Manager and antivirus show for Orca.exe.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION ORCA_VERSION_NUM
 PRODUCTVERSION ORCA_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Standalone fork contributors"
      VALUE "FileDescription", "Project+ Standalone Rollback"
      VALUE "FileVersion", ORCA_VERSION_STR
      VALUE "InternalName", "ProjectPlusRollback"
      VALUE "LegalCopyright", "GPL-2.0-or-later. Based on the Dolphin emulator."
      VALUE "OriginalFilename", "ProjectPlusRollback.exe"
      VALUE "ProductName", "Project+ Standalone Rollback"
      VALUE "ProductVersion", ORCA_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
